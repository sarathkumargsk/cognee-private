# NebulaGraph Configuration
# Copy this file to .env and update with your actual values

# Graph Database Provider
# Set to 'nebulagraph' to use NebulaGraph adapter
GRAPH_DATABASE_PROVIDER=nebulagraph
GRAPH_DATASET_DATABASE_HANDLER=nebulagraph

# NebulaGraph Connection Settings
# Host address of NebulaGraph GraphD service
NEBULA_GRAPH_HOST=127.0.0.1

# Port for NebulaGraph GraphD service (default: 9669)
NEBULA_GRAPH_PORT=9669

# NebulaGraph username (default: root)
NEBULA_GRAPH_USERNAME=root

# NebulaGraph password (default: nebula)
NEBULA_GRAPH_PASSWORD=nebula

# Maximum connection pool size (default: 10)
# Increase for high-concurrency workloads
NEBULA_GRAPH_MAX_POOL_SIZE=10

# Logical Separation Settings
# Shared space name - all tenants use this space (default: cognee)
# Created automatically on first connection
NEBULA_GRAPH_SPACE=cognee

# Logical graph identifier for data isolation (default: default)
# Use different values for multi-tenant isolation:
# - 'default' for single-tenant deployments
# - 'tenant_a', 'tenant_b', etc. for multi-tenant deployments
# - Project-specific IDs like 'project_123' for project-based isolation
NEBULA_GRAPH_ID=default

# Optional: Cognee General Configuration
# Uncomment and configure if using full Cognee integration

# COGNEE_API_KEY=your_api_key_here
# VECTOR_DATABASE_PROVIDER=qdrant
# LLM_PROVIDER=openai
